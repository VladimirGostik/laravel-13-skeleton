{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "vue-tsc --noEmit",
        "lint": "pnpm run lint:js && pnpm run lint:prettier",
        "lint:js": "eslint resources/js/ vite.config.js",
        "lint:prettier": "prettier --check resources/js/ resources/css/ *.{js,json,md}",
        "fix": "pnpm run fix:js && pnpm run fix:prettier",
        "fix:js": "eslint --fix resources/js/ vite.config.js",
        "fix:prettier": "prettier --write resources/js/ resources/css/ *.{js,json,md}",
        "generate-types": "php artisan typescript:transform"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@heroicons/vue": "^2.2.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^25.6.0",
        "@typescript-eslint/eslint-plugin": "^8.59.2",
        "@typescript-eslint/parser": "^8.59.2",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vue/tsconfig": "^0.9.1",
        "concurrently": "^9.0.1",
        "daisyui": "^5.5.19",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.9.0",
        "laravel-vite-plugin": "^1.3.0",
        "lefthook": "^2.1.6",
        "prettier": "^3.8.3",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "vite": "^7.3.2",
        "vue-eslint-parser": "^10.4.0",
        "vue-tsc": "^3.2.8"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.0.3",
        "vue": "^3.5.33",
        "ziggy-js": "^2.6.2"
    }
}
